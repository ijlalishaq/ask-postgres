# Needed for pnpm ask, pnpm serve and pnpm bench:run. Tests and scoring run without it.
ANTHROPIC_API_KEY=

# The database to ask questions of, through a read-only role.
DATABASE_URL=postgres://reader@localhost:5432/mydb

# Where pnpm bench:* finds the restored Mini-Dev databases (defaults to the local cluster).
# BENCH_DATABASE_URL=postgres://asker@localhost:54329/postgres
